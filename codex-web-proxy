#!/usr/bin/env bash
set -euo pipefail
ROOT="${CODEX_WEB_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)}"
export PATH="/opt/homebrew/bin:/Applications/ChatGPT.app/Contents/Resources:/Applications/Codex.app/Contents/Resources:/usr/bin:/bin:/usr/sbin:/sbin"

resolve_codex_bin() {
  local candidate
  if [[ -n "${CODEX_BIN:-}" && -x "$CODEX_BIN" ]]; then
    printf '%s\n' "$CODEX_BIN"
    return
  fi
  for candidate in \
    "/Applications/ChatGPT.app/Contents/Resources/codex" \
    "/Applications/Codex.app/Contents/Resources/codex" \
    "$ROOT/node_modules/.bin/codex"; do
    if [[ -x "$candidate" ]]; then
      printf '%s\n' "$candidate"
      return
    fi
  done
  command -v codex
}

args=("$@")
command_index=0
while [[ "${args[$command_index]:-}" == "-c" ]]; do
  ((command_index += 2))
done

if [[ "${args[$command_index]:-}" != "app-server" ]]; then
  CODEX_BIN="$(resolve_codex_bin)"
  exec "$CODEX_BIN" "$@"
fi

export CODEX_UNIX_SOCKET="$ROOT/codex-web-app-server.sock"
exec "$ROOT/scripts/codex_remote_proxy" "$@"
